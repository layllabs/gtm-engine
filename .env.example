# Copy to .env and fill in what you use. Never commit .env (it is gitignored).
# `python -m gtm connect` reads these and probes each configured tool read-only.

# Source control and CI
GITHUB_TOKEN=

# Sequencers (use one)
SMARTLEAD_API_KEY=
OUTREACH_ACCESS_TOKEN=
APOLLO_API_KEY=

# CRM (use one)
SFDC_ACCESS_TOKEN=
SFDC_INSTANCE_URL=https://yourorg.my.salesforce.com
HUBSPOT_ACCESS_TOKEN=

# Verification and enrichment
ZEROBOUNCE_API_KEY=
CLAY_WEBHOOK_URL=

# Model
ANTHROPIC_API_KEY=
